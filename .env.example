# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Gemini API key for the AI sustainability-analysis narration layer
# (app/api/sustainability-analysis). Server-side only, never exposed to
# the browser. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional, defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash
