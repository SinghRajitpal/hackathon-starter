# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Service role key (same page, "service_role secret"). Server-only -- never
# expose this to the browser. Used by lib/supabase/admin.ts, which
# lib/gemini/client.ts uses to fetch the Gemini API key stored in Supabase
# Vault (see get_gemini_api_key() in supabase/schema.sql). The Gemini key
# itself lives only in Vault, not in any env file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Net-zero tool (features/netzero): the same service key under the name its
# server code reads. /api/explain uses it to fetch gemini_api_key from Vault
# and to read and write the nz_explanations cache.
SUPABASE_SECRET_KEY=your-service-role-key

# Sustainability tool (features/sustainability): reads its Gemini key from env,
# not Vault. GEMINI_MODEL is optional and defaults to gemini-2.5-flash.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
